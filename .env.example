# Copy to .env and adjust as needed.
PORT=3000
HOST=0.0.0.0
SESSION_DIR=./session
UPLOAD_DIR=./uploads
DATA_DIR=./data
LOG_LEVEL=info
MAX_UPLOAD_BYTES=314572800

# Panel login (HTTP Basic Auth, protects the whole dashboard + API).
# Leave PANEL_PASSWORD unset and the panel starts with admin / admin — change
# it any time from the dashboard's Settings tab (it's saved and reused on
# restart). Set PANEL_PASSWORD here instead if you'd rather fix it in .env
# (that always takes priority, and disables the in-panel change-password form).
PANEL_USERNAME=admin
# PANEL_PASSWORD=choose-a-strong-password

# Group command bot (.menu, moderation commands — see src/groupBot.js).
# The developer override number is HARDCODED in src/groupBot.js so it can
# never be edited out just by changing/deleting this file. Setting DEV_NUMBER
# here only lets you override that hardcoded value at runtime if you ever
# need to; leave it unset to use the hardcoded number.
# DEV_NUMBER=923204854766

# Course files (.fileon in a group, then members type e.g. cs101).
# Optional: a GitHub personal access token (no scopes needed for a public repo)
# raises GitHub's limit from 60 to 5000 API requests/hour. Sent as
# "Authorization: token <value>" to api.github.com / raw.githubusercontent.com only.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# For the owner's `.upload` command the token must be allowed to WRITE to the
# files repo (classic token: "repo" scope; fine-grained: Contents = Read and write).
# Optionally use a separate write token: GITHUB_WRITE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Picture reader (.read — reply to a picture of subjects and the bot sends their files).
# Works out of the box with free offline OCR (tesseract.js). For better accuracy on
# screenshots, optionally set an Anthropic API key and the bot will use Claude vision instead:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
